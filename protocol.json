  "session_model": {
    "_": "В тоннеле одновременно до Maxactive групп (2). Промпт привязан к гостю 1..3 ВНУТРИ группы, трекинг знает только физический бикон — поэтому мастер держит привязку бикон -> (номер сессии, гость) и ставит номер сессии в адрес сообщений.",
    "session_num": "сквозной счётчик мастера, для людей, логов и адресации",
    "session_uuid": "приходит с панели, для сверки",
    "guest_index": "1..3 внутри группы",
    "beacon": "физический BlackTrax ID (1..12)",
    "max_active_groups": 2,
    "assign_modes": {
      "auto": "первый вошедший в зону входа — гость 1, второй — гость 2 и т.д.",
      "pool": "биконы закреплены за слотами (таблица beacon_pools), слоты чередуются между группами; гость = позиция бикона в своём пуле",
      "manual": "оператор назначает в пульте"
    },
    "session_close": "все биконы группы вне зон дольше Exitgrace (8 с) -> /show/session/end, биконы освобождаются",
    "force_mode": {
      "_": "Ручка оператора: команды зонам уходят с force=1 — зона обязана немедленно прервать текущее состояние и выполнить команду с нуля, игнорируя свои блокировки и отсутствие сессии. Нужен на прогонах и когда зона зависла.",
      "par": "Forcemode на show_control (тумблер ПРИНУДИТЕЛЬНО в пульте)",
      "applies_to": [
        "/zone{N}/start",
        "/zone{N}/restart",
        "/zone{N}/reset"
      ],
      "all_zones": "кнопки ВСЕ: СТАРТ / ВСЕ: РЕСТАРТ / ВСЕ: СБРОС шлют команду каждой зоне из таблицы slaves"
    }
  },
  "messages": {
